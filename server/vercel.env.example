# Set these in Vercel Project Settings > Environment Variables, never VITE_*.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/aeviora_wellness?retryWrites=true&w=majority
MONGO_DB_NAME=aeviora_wellness
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET
COOKIE_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
FRONTEND_ORIGIN=https://YOUR_DOMAIN
# Use approved policy versions and URLs; production registration rejects drafts.
ACCOUNT_TERMS_VERSION=REPLACE_WITH_APPROVED_VERSION
ACCOUNT_TERMS_URL=/account-terms
ACCOUNT_PRIVACY_VERSION=REPLACE_WITH_APPROVED_VERSION
ACCOUNT_PRIVACY_URL=/account-privacy
ACCOUNT_REQUIRED_ADDRESS_FIELDS=
# Optional billing configuration:
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
# Leave VITE_API_BASE_URL unset for same-domain /api requests.
