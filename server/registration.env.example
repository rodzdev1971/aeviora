# Merge these settings into server/.env; do not replace existing secrets.
# New accounts are pending unless this is true outside production.
DEV_ACTIVATE_ACCOUNTS=false

# Optional address requirements: addressLine1,city,state
ACCOUNT_REQUIRED_ADDRESS_FIELDS=

# Replace with the versions and URLs of your approved account policies.
# Leaving these unset enables clearly marked development drafts only.
# ACCOUNT_TERMS_VERSION=
# ACCOUNT_TERMS_URL=/termsofuse
# ACCOUNT_PRIVACY_VERSION=
# ACCOUNT_PRIVACY_URL=

FRONTEND_ORIGIN=http://localhost:5173

# Stripe test-mode configuration. Never expose STRIPE_SECRET_KEY to the frontend.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
