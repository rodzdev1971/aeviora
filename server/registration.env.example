# Merge these settings into server/.env; do not replace existing secrets.
# New accounts require email verification even when this development flag is true.
DEV_ACTIVATE_ACCOUNTS=false

# Registration verification links and admin account emails (see docs/email-setup.md).
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=info@aeviorawellness.com

# Optional address requirements: addressLine1,city,state
ACCOUNT_REQUIRED_ADDRESS_FIELDS=

# Replace with the versions and URLs of your approved account policies.
# Leaving these unset enables clearly marked development drafts only.
# ACCOUNT_TERMS_VERSION=
# ACCOUNT_TERMS_URL=/account-terms
# ACCOUNT_PRIVACY_VERSION=
# ACCOUNT_PRIVACY_URL=

# Verification links expire in 24 hours. Set the public HTTPS application origin in production.
FRONTEND_ORIGIN=http://localhost:5173

# Stripe test-mode configuration. Never expose STRIPE_SECRET_KEY to the frontend.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Admin browser push notifications (generate once: npm run push:keys).
# Keep the private key server-only; add all three values to Vercel and redeploy.
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:info@aeviorawellness.com
